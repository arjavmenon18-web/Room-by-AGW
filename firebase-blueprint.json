{
  "entities": {
    "rooms": {
      "title": "Room",
      "description": "Virtual meeting space created in ROOM by Armen GlobalWorks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique room code e.g. ROOM-ABCDE" },
        "title": { "type": "string", "description": "Title or agenda summary of the conference" },
        "createdBy": { "type": "string", "description": "Creator identifier or display name" },
        "hostId": { "type": "string", "description": "Host user UID or local ID" },
        "hostName": { "type": "string", "description": "Host display name" },
        "status": { "type": "string", "description": "Status of the room (active, ended)" },
        "notes": { "type": "string", "description": "Shared collaborative meeting notes" },
        "googleMeetUri": { "type": "string", "description": "Synced Google Meet URI" },
        "googleMeetCode": { "type": "string", "description": "Synced Google Meet space code" },
        "features": { "type": "object", "description": "Room permissions and toggles" },
        "agenda": { "type": "array", "description": "Agenda items for the meeting" },
        "files": { "type": "array", "description": "Shared workspace documents and assets" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title"]
    },
    "rooms/messages": {
      "title": "Message",
      "description": "Live real-time meeting chat messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "reactions": { "type": "array" }
      },
      "required": ["senderName", "text", "timestamp"]
    },
    "rooms/participants": {
      "title": "Participant",
      "description": "Live participant presence in a room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "micOn": { "type": "boolean" },
        "videoOn": { "type": "boolean" },
        "screenSharing": { "type": "boolean" },
        "handRaised": { "type": "boolean" },
        "lastSeen": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "conversations": {
      "title": "Conversation",
      "description": "ROOM persistent Chat conversation or space",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "memberIds": { "type": "array" },
        "projectId": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "isMuted": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "type"]
    },
    "conversations/messages": {
      "title": "DirectChatMessage",
      "description": "Persistent chat messages in ROOM Chat conversations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" },
        "reactions": { "type": "object" }
      },
      "required": ["id", "conversationId", "senderId", "content"]
    },
    "keepItems": {
      "title": "KeepItem",
      "description": "ROOM Keep intelligent memory item (ideas, decisions, tasks, references, questions)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "projectId": { "type": "string" },
        "assignedTo": { "type": "string" },
        "source": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "category", "status"]
    },
    "meetingRecords": {
      "title": "MeetingRecord",
      "description": "Persistent post-meeting archive with continuity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roomId": { "type": "string" },
        "roomTitle": { "type": "string" },
        "date": { "type": "string" },
        "durationFormatted": { "type": "string" },
        "participantCount": { "type": "number" },
        "summary": { "type": "string" },
        "decisions": { "type": "array" },
        "tasks": { "type": "array" }
      },
      "required": ["id", "roomId", "roomTitle"]
    },
    "projects": {
      "title": "Project",
      "description": "ROOM Project container connecting conversations, meetings, files and memories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "conversationId": { "type": "string" },
        "timeline": { "type": "array" }
      },
      "required": ["id", "title"]
    }
  },
  "firestoreRules": "firestore.rules"
}
